# Kopieer naar .env (staat in .gitignore) en vul je token in:
#   cp .env.example .env && chmod 600 .env
# Persoonlijk API-token uit Moneybird (Instellingen > Ontwikkelaars), leesrechten zijn genoeg.
MONEYBIRD_TOKEN=
# Optioneel: token voor concrexit (thalia.nu), om de evenementen op te halen naar events.csv.
# Aanmaken in de Django-admin (OAuth2 provider > Access tokens), scope events:admin.
CONCREXIT_TOKEN=
