# Kopieer naar .env (staat in .gitignore) en vul je token in:
#   cp .env.example .env && chmod 600 .env
# Persoonlijk API-token uit Moneybird (Instellingen > Ontwikkelaars), leesrechten zijn genoeg.
MONEYBIRD_TOKEN=

# Optioneel, om te testen: een access token van thalia.nu (scope events:admin). Normaal niet nodig:
# koppel dan met "python3 jaarverslag.py --concrexit-login", dat bewaart de tokens zelf.
# CONCREXIT_TOKEN=
